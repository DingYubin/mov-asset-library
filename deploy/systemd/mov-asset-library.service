[Unit]
Description=MOV Asset Library API
After=network.target

[Service]
Type=simple
User=movasset
Group=movasset
WorkingDirectory=/opt/mov-asset-library
EnvironmentFile=/etc/mov-asset-library.env
ExecStart=/opt/mov-asset-library/.venv/bin/uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8800 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mov-asset-library

[Install]
WantedBy=multi-user.target
