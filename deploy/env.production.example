APP_ENV=production
APP_SECRET_KEY=replace-with-a-64-byte-random-secret
DATABASE_URL=sqlite:////var/lib/mov-asset-library/asset_library.db
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/var/lib/mov-asset-library/storage
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=1800
COOKIE_SECURE=true
MAX_UPLOAD_BYTES=536870912

# Switch to Tencent Cloud COS after creating a private bucket:
# STORAGE_BACKEND=cos
# COS_SECRET_ID=
# COS_SECRET_KEY=
# COS_REGION=ap-guangzhou
# COS_BUCKET=your-bucket-appid
# COS_PUBLIC_BASE_URL=
