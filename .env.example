APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/asset_library.db
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./data/storage
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=1800
COOKIE_SECURE=false

# Production database example:
# DATABASE_URL=mysql+pymysql://asset_library:password@private-db-host:3306/mov_asset_library?charset=utf8mb4

# Tencent Cloud COS (used when STORAGE_BACKEND=cos):
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_PUBLIC_BASE_URL=
